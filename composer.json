{
    "name": "astroinsightapi/astroinsight-php-sdk",
    "description": "Official PHP SDK for the Astro Insight API - Astrology, Numerology, Panchang, Tarot, and Divination services.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "astrology",
        "vedic-astrology",
        "panchang",
        "horoscope",
        "tarot",
        "numerology",
        "astro-insight",
        "sdk"
    ],
    "authors": [
        {
            "name": "Astro Insight Team",
            "email": "support@astroinsight.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AstroInsight\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AstroInsight\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
